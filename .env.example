# deskbell — copy to .env and fill in.
#   cp .env.example .env
#
# Nothing here is optional except the sections marked OPTIONAL. deskbell starts
# with only Twilio configured; every other channel degrades gracefully.

# ─────────────────────────────────────────────────────────────
# Core — required
# ─────────────────────────────────────────────────────────────

POSTGRES_USER=deskbell
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=deskbell

# Encrypts stored n8n credentials. Generate with:
#   openssl rand -hex 32
# Back this up. If you lose it you re-enter every credential; if you change it
# the existing ones become unreadable.
N8N_ENCRYPTION_KEY=

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-too

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http

# The public base URL providers will post webhooks to. For local testing run a
# tunnel (`cloudflared tunnel --url http://localhost:5678`) and paste the URL.
# Twilio and WhatsApp cannot reach http://localhost.
DESKBELL_BASE_URL=http://localhost:5678

# IANA timezone. Drives quiet hours and every formatted date the customer sees.
DESKBELL_TIMEZONE=UTC

# ─────────────────────────────────────────────────────────────
# SMS and voice — Twilio
# ─────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=+10000000000
# The auth token goes in an n8n *credential* (HTTP Basic Auth: username =
# Account SID, password = Auth Token), not here — n8n encrypts credentials at
# rest, and this file is plain text on disk.

# ─────────────────────────────────────────────────────────────
# WhatsApp Business Cloud API — OPTIONAL
# ─────────────────────────────────────────────────────────────

WHATSAPP_PHONE_NUMBER_ID=
# The permanent access token goes in an n8n Header Auth credential named
# "deskbell whatsapp": name = Authorization, value = Bearer EAAG...
# Token used to verify the webhook subscription in Meta's dashboard:
WHATSAPP_VERIFY_TOKEN=pick-any-string-and-paste-it-into-meta

# ─────────────────────────────────────────────────────────────
# Email — OPTIONAL but strongly recommended
# ─────────────────────────────────────────────────────────────
# Without this you get no daily digest and no error alerts, which means you
# will not notice when deskbell stops working.

DESKBELL_FROM_EMAIL=noreply@yourbusiness.com
# SMTP host/user/password go in an n8n SMTP credential.

# ─────────────────────────────────────────────────────────────
# Voice AI — OPTIONAL (VAPI)
# ─────────────────────────────────────────────────────────────
# Only used when a preset enables escalation.voiceEnabled.

VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────────────────────
# AI reply classification — OPTIONAL (Anthropic)
# ─────────────────────────────────────────────────────────────
# Regex handles ~95% of replies for free. This only sees genuinely ambiguous
# messages, and only when `ai.enabled` is true in the config.

ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Advanced — OPTIONAL
# ─────────────────────────────────────────────────────────────

# Overrides the config baked into workflow 00. Paste the contents of a preset
# from config/presets/ as a single-line JSON string. Leave empty to use the
# config edited directly in the "deskbell/00 Config" workflow.
DESKBELL_CONFIG=

# n8n API key, used by `npm run import`. Create one in n8n:
# Settings -> API -> Create an API key.
N8N_API_KEY=
N8N_API_URL=http://localhost:5678/api/v1

# How long to keep execution history, in hours. Default 14 days.
EXECUTIONS_MAX_AGE_HOURS=336
